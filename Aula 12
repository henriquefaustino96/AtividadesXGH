import pandas as pd
import requests

pd.DataFrame({"cliente": ["Ana", "Bruno", "Carla"], "cep": ["11013001", "99999999", "123"]}).to_csv("clientes.csv", index=False)

def preencher_clientes():
    df = pd.read_csv("clientes.csv")
    situacao = []
    
    for cep in df["cep"]:
        r = requests.get(f"https://viacep.com.br/ws/{cep}/json/", timeout=5)
        if r.status_code != 200:
            situacao.append("erro")
        elif "erro" in r.json():
            situacao.append("nao encontrado")
        else:
            situacao.append("ok")
            
    df["situacao"] = situacao
    df.to_csv("clientes_pronto.csv", index=False)
    print(df)

preencher_clientes()




