#buscador de cep excercico 1#

import requests

def buscar_cep(cep):
    try:
        r = requests.get(f"https://viacep.com.br/ws/{cep}/json/", timeout=5)
        if r.status_code != 200:
            return "CEP invalido"
        dados = r.json()
        if "erro" in dados:
            return "CEP nao encontrado"
        return f"{dados['logradouro']} - {dados['localidade']}"
    except:
        return "Erro ao buscar"

for cep in ["11013001", "99999999", "123"]:
    print(cep, "->", buscar_cep(cep))

#exercicio 2 usar outra API ABERTA#

import requests

def ver_idade(nome):
    r = requests.get("https://api.agify.io", params={"name": nome, "country_id": "BR"}, timeout=5)
    dados = r.json()
    print(nome, "-> idade estimada:", dados["age"])

ver_idade("henrique")

#3 api que resolva um problema meu#
 
import requests

def buscar_musicas(banda):
    url = "https://itunes.apple.com/search"
    params = {"term": banda, "entity": "song", "attribute": "artistTerm", "limit": 5}
    r = requests.get(url, params=params, timeout=5)
    dados = r.json()
    
    for musica in dados["results"]:
        print(musica["artistName"], "-", musica["trackName"])

buscar_musicas("Guns N' Roses")

