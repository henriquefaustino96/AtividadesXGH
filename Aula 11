
import pandas as pd
import random

# 0. Gera o arquivo vendas.xlsx na pasta AtividadesXGH
random.seed(11)
lojas = ["Centro", "Shopping", "Online"]

linhas = [
    {"mes": f"2026-{m:02d}",
     "loja": random.choice(lojas),
     "pecas": random.randint(10, 90),
     "faturamento": round(random.uniform(3000, 28000), 2)}
    for m in range(1, 13) for _ in range(3)
]

pd.DataFrame(linhas).to_excel("vendas.xlsx", index=False)

# 1. Lê o Excel e roda o diagnóstico
def diagnosticar(df):
    print("=" * 40)
    print(f"Total de linhas: {len(df)} | Colunas: {len(df.columns)}")
    print("-" * 40)

    faltantes = df.isna().sum()
    faltantes = faltantes[faltantes > 0]
    if faltantes.empty:
        print("Valores faltando: Nenhum!")
    else:
        print("Colunas com valor faltando:")
        for col, qtd in faltantes.items():
            print(f"  - {col}: {qtd} faltando")

    print("-" * 40)
    print(f"Linhas duplicadas: {df.duplicated().sum()}")

    print("-" * 40)
    print("Tipos das colunas:")
    for col, tipo in df.dtypes.items():
        print(f"  - {col}: {tipo}")
    print("=" * 40)

df_excel = pd.read_excel("vendas.xlsx")
diagnosticar(df_excel)



