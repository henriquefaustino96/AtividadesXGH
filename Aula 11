import pandas as pd

def diagnosticar(df):
    print("Linhas:", len(df))
    print("Duplicadas:", df.duplicated().sum())
    print("Faltando:")
    print(df.isnull().sum())
    print("Tipos:")
    print(df.dtypes)

df_excel = pd.read_excel("vendas.xlsx")
diagnosticar(df_excel)

