#QR CODE#

import qrcode

link = input("Digite o link ou texto para o QR Code: ").strip()
nome_arquivo = input("Digite o nome do arquivo para salvar (ex: meu_qr): ").strip()

if not nome_arquivo:
    nome_arquivo = "qrcode_gerado.png"
elif not nome_arquivo.lower().endswith(".png"):
    nome_arquivo += ".png"

img = qrcode.make(link)
img.save(nome_arquivo)

print(f"QR Code salvo com sucesso como '{nome_arquivo}'!")