#exercicio 3 limpeza#

av = pd.read_csv("avaliacoes.csv")

def limpar(df):
    
    limpo = df.copy()
    
    limpo = limpo.dropna(subset=["texto", "sentimento"])
    
    limpo["texto"] = limpo["texto"].str.strip().str.lower()
    limpo["sentimento"] = limpo["sentimento"].str.strip().str.lower()
    
    limpo = limpo[(limpo["sentimento"] == "positivo") | (limpo["sentimento"] == "negativo")]
    
    limpo = limpo.drop_duplicates()
    
    return limpo

av_limpo = limpar(av)
print("Antes:", len(av), "| Depois:", len(av_limpo))

sujeira = pd.DataFrame({
    "texto": ["  produto bom  ", "produto bom", "gostei muito"],
    "sentimento": ["POSITIVO", " positivo ", "nao sei"]
})

av_sujo = pd.concat([av, sujeira])
av_recuperado = limpar(av_sujo)
print("Com sujeira nova:", len(av_sujo), "| Recuperado:", len(av_recuperado))



