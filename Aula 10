#relatorio de vendas#

import pandas as pd

df = pd.read_csv("vendas.csv")

# 1. Qual cidade fatura mais, e qual vende mais peças
por_cidade = df.groupby("cidade").agg(
    faturamento_total=("valor", "sum"),
    pecas_vendidas=("quantidade", "sum")
)
print("--- Por Cidade ---")
print(por_cidade)
print("Cidade que fatura mais:", por_cidade["faturamento_total"].idxmax())
print("Cidade que vende mais peças:", por_cidade["pecas_vendidas"].idxmax())

# 2. Qual produto tem o maior ticket médio (média da coluna 'valor' por venda)
ticket_produto = df.groupby("produto")["valor"].mean()
print("\n--- Ticket Médio por Produto ---")
print(ticket_produto.sort_values(ascending=False).round(2))
print("Maior ticket médio:", ticket_produto.idxmax())

# 3. Qual mês foi o melhor
df["data"] = pd.to_datetime(df["data"])
df["mes"] = df["data"].dt.to_period("M")

por_mes = df.groupby("mes")["valor"].sum()
print("\n--- Faturamento por Mês ---")
print(por_mes)
print("Melhor mês:", por_mes.idxmax())

# 4. As 10 maiores vendas
top_10 = df.sort_values(by="valor", ascending=False).head(10)
print("\n--- Top 10 Maiores Vendas ---")
print(top_10[["data", "cidade", "produto", "quantidade", "valor"]])


#Diagnóstico de tabela#

import pandas as pd

def diagnosticar(df):
    print("=" * 40)
    print(f"Total de linhas: {len(df)} | Colunas: {len(df.columns)}")
    print("-" * 40)

    
    faltantes = df.isna().sum()
    faltantes = faltantes[faltantes > 0]
    if faltantes.empty:
        print("Valores faltando: Nenhum!")
    else:
        print("Colunas com valor faltando:")
        for col, qtd in faltantes.items():
            print(f"  - {col}: {qtd} faltando")

    print("-" * 40)
   
    print(f"Linhas duplicadas: {df.duplicated().sum()}")

    print("-" * 40)
    
    print("Tipos das colunas:")
    for col, tipo in df.dtypes.items():
        print(f"  - {col}: {tipo}")
    print("=" * 40)



