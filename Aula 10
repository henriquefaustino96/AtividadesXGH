##exercicio 1 do relatorio de venda#

import pandas as pd

df_vendas = pd.read_csv("vendas.csv")

def relatorio_vendas(df):
    print("Faturamento por cidade:")
    print(df.groupby("cidade")["valor"].sum().round(2))
    
    print("Pecas por cidade:")
    print(df.groupby("cidade")["quantidade"].sum())
    
    print("Ticket medio por produto:")
    print(df.groupby("produto")["valor"].mean().round(2))
    
    df["mes"] = df["data"].str[5:7]
    print("Faturamento por mes:")
    print(df.groupby("mes")["valor"].sum().round(2))
    
    print("10 maiores vendas:")
    print(df.nlargest(10, "valor")[["data", "cidade", "produto", "valor"]])

relatorio_vendas(df_vendas)

