    import pandas as pd


dados_sujos = """aluno,curso,nota
Ana,Python,8.5
Bruno,Python,"7,5"
Ana,Python,8.5
Carla,IA,
Diego,IA,n/a
Elis,  python ,9.0
Fabio,IA,15.0
Gustavo,Python,-3.0
"""

with open("avaliacoes.csv", "w", encoding="utf-8") as f:
    f.write(dados_sujos)

def limpar(df):
    
    df = df.copy()

    df["aluno"] = df["aluno"].astype(str).str.strip().str.title()
    df["curso"] = df["curso"].astype(str).str.strip().str.upper()
    df["nota"] = df["nota"].astype(str).str.replace(",", ".", regex=False)
    df["nota"] = pd.to_numeric(df["nota"], errors="coerce")

    
    df = df.dropna(subset=["aluno", "nota"])

   
    df = df[(df["nota"] >= 0) & (df["nota"] <= 10)]

   
    df = df.drop_duplicates()

   
    return df.reset_index(drop=True)


bruto = pd.read_csv("avaliacoes.csv")
print("ANTES DA LIMPEZA:")
print(bruto)

limpo = limpar(bruto)
print("\nDEPOIS DA LIMPEZA:")
print(limpo)
