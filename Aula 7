agenda = [
    {"nome": "Henrique", "telefone": "13 99999-1111", "cidade": "Santos"},
    {"nome": "Mariana",  "telefone": "11 98888-2222", "cidade": "São Paulo"},
    {"nome": "Lucas",    "cidade": "Santos"},  # sem telefone cadastrado
    {"nome": "Fernanda", "telefone": "13 97777-3333"}  # sem cidade cadastrada
]

def buscar(agenda, nome):
    for contato in agenda:
        if contato["nome"].lower() == nome.lower():
            return contato
    return None

def de_cidade(agenda, cidade):
    encontrados = []
    for contato in agenda:
        if contato.get("cidade", "").lower() == cidade.lower():
            encontrados.append(contato["nome"])
    return encontrados

