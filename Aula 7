#Refatorar o boletim (com lista de dicionários + embaralhamento)#

import random

def media_da_turma(turma):
    soma = 0
    for a in turma:
        soma += a["nota"]
    return soma / len(turma)

def maior_nota(turma):
    melhor = turma[0]
    for a in turma:
        if a["nota"] > melhor["nota"]:
            melhor = a
    return melhor["nome"]

def aprovados(turma, corte=7):
    lista = []
    for a in turma:
        if a["nota"] >= corte:
            lista.append(a["nome"])
    return lista


boletim = [
    {"nome": "Henrique", "nota": 8.5},
    {"nome": "Mariana",  "nota": 9.2},
    {"nome": "Lucas",    "nota": 6.0},
    {"nome": "Fernanda", "nota": 7.8},
    {"nome": "Rafael",   "nota": 5.5}
]


random.shuffle(boletim)

for aluno in boletim:
    print(f"{aluno['nome']:10s} -> {aluno['nota']}")

print(f"\nMédia: {media_da_turma(boletim):.2f}")
print(f"Maior nota: {maior_nota(boletim)}")
print(f"Aprovados: {aprovados(boletim)}")



